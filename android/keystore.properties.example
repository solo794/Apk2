# انسخ الملف ده لـ android/keystore.properties واملأه ببيانات مفتاحك.
# ⛔ ملف keystore.properties نفسه متجاهَل في .gitignore ومينفعش يتحفظ في المستودع.
#
# storeFile ممكن يكون مسار كامل أو نسبي لمجلد android/
storeFile=upload-keystore.jks
storePassword=الباسوورد-بتاع-المفتاح
keyAlias=upload
keyPassword=باسوورد-الـalias
