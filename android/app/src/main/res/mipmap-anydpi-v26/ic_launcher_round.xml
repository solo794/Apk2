<?xml version="1.0" encoding="utf-8"?>
<!-- Standard adaptive icon: the background layer is a full-bleed emerald tile and the foreground
     keeps its art inside the central 72dp safe zone, so no <inset> wrapper is needed (the old one
     shrank both layers, which left the background short of the launcher's mask on shaped icons). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
